{
  "info": {
    "_postman_id": "4303e354-b188-4e95-8ed0-01d36f124521",
    "name": "Quản lý sinh viên - Chương 2",
    "description": "Các request và kiểm tra API theo bài thực hành chương 2. Hãy khởi động lại server trước khi chạy lại request tạo SV003.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "02 - Lấy danh sách sinh viên",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sinh-vien"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trả về HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Có success=true và danh sách sinh viên', function () {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an('array');",
              "});",
              "pm.test('Danh sách ban đầu có SV001 và SV002', function () {",
              "  const maSVs = body.data.map((sinhVien) => sinhVien.maSV);",
              "  pm.expect(maSVs).to.include('SV001');",
              "  pm.expect(maSVs).to.include('SV002');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Tìm sinh viên SV001",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sinh-vien/SV001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trả về HTTP 200 và đúng sinh viên', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.maSV).to.eql('SV001');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Không tìm thấy sinh viên SV999",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/sinh-vien/SV999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trả về HTTP 404 và success=false', function () {",
              "  pm.response.to.have.status(404);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Thêm sinh viên SV003",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV003\",\n  \"hoTen\": \"Ngoc Mai\",\n  \"email\": \"ngocmai@example.com\",\n  \"maLop\": \"25CT114\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/sinh-vien"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trả về HTTP 201 và sinh viên vừa tạo', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.maSV).to.eql('SV003');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Từ chối dữ liệu thiếu họ tên",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV004\",\n  \"email\": \"thungniem@example.com\",\n  \"maLop\": \"25CT114\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/sinh-vien"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dữ liệu không hợp lệ bị từ chối với HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Từ chối mã sinh viên trùng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV001\",\n  \"hoTen\": \"Sinh viên trùng\",\n  \"email\": \"trung@example.com\",\n  \"maLop\": \"25CT114\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/sinh-vien"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Mã sinh viên trùng bị từ chối với HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
